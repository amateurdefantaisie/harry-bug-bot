# Harry Bug Bot - Configuration

# Préfixe des commandes (ex: !spam, !stop)
PREFIX=!

# Contact cible pour les tests (numéro au format international, sans +)
# Exemple : 33612345678
TARGET_NUMBER=

# Délai minimum entre chaque message en secondes
DELAY_MIN=1

# Délai maximum entre chaque message en secondes
DELAY_MAX=6

# Nombre de messages par salve (batch)
BATCH_SIZE=30

# Pause entre chaque salve en secondes
BATCH_PAUSE=8

# Mode silencieux : true = les messages sont envoyés sans notification
# Dépend du contact cible
SILENT_MODE=false

# Message par défaut
DEFAULT_MESSAGE=🔮 Harry Bug Bot - Je vais te bloqué 🥲🤲 désolé camaradecamaradecamaradecamarade