# Préfixe des commandes
PREFIX=!

# Renseignez vos numéros réels au format international (8 à 15 chiffres, sans texte).
# Numéros administrateurs autorisés, séparés par des virgules.
# Tant que cette variable est vide, toutes les commandes sont refusées.
ADMIN_NUMBERS=

# Cibles de test ayant explicitement consenti, séparées par des virgules.
# Tant que cette variable est vide, aucun destinataire n'est autorisé.
TARGET_NUMBERS=
TARGET_NUMBER=

# Limites de test : 1 à 5 messages par exécution au maximum
MAX_MESSAGES_PER_RUN=1
DELAY_MIN=2
DELAY_MAX=6
BATCH_SIZE=1
BATCH_PAUSE=30

DEFAULT_MESSAGE=Harry Bug Bot - message de test autorisé
SESSION_NAME=harry-bug-session

# N'activer que si l'environnement ne permet pas Chromium avec sandbox.
PUPPETEER_NO_SANDBOX=false
